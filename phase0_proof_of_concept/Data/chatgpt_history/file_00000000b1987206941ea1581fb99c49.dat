import pandas as pd
from flask import Flask, jsonify
from flask import request
from db import get_connection

app = Flask(__name__)

@app.route('/drivers', methods=['POST'])
def add_driver():
    data = request.get_json(silent=True)              # grab the JSON data sent by the client

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    name = data.get('name')
    phone = data.get('phone')
    vehicle_info = data.get('vehicle_info')

    if not name or not phone or not vehicle_info:
        return jsonify({"error": "name, phone, and vehicle_info are required"}), 400

    conn = get_connection()                # open db connection, same as before
    cur = conn.cursor()

    cur.execute(
        "INSERT INTO drivers (name, phone, vehicle_info, subscription_status) VALUES (%s, %s, %s, %s)",
        (name, phone, vehicle_info, 'active')
    )

    conn.commit()                          # save the change permanently to the database
    cur.close()
    conn.close()

    return jsonify({"message": "Driver added successfully"}), 201


@app.route('/drivers', methods=['GET'])
def get_drivers():
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT id, name, phone, vehicle_info, subscription_status FROM drivers")
    rows = cur.fetchall()

    cur.close()
    conn.close()

    drivers = []
    for row in rows:
        drivers.append({
            "id": row[0],
            "name": row[1],
            "phone": row[2],
            "vehicle_info": row[3],
            "subscription_status": row[4]
        })

    return jsonify(drivers), 200

@app.route('/drivers/<int:driver_id>', methods=['GET'])
def get_driver_by_id(driver_id):
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT id, name, phone, vehicle_info, subscription_status FROM drivers WHERE id = %s", (driver_id,))
    row = cur.fetchone()

    cur.close()
    conn.close()

    if row is None:
        return jsonify({"error": "Driver not found"}), 404

    driver = {
        "id": row[0],
        "name": row[1],
        "phone": row[2],
        "vehicle_info": row[3],
        "subscription_status": row[4]
    }

    return jsonify(driver), 200

@app.route('/drivers/search', methods=['GET'])
def search_driver_by_name():
    name = request.args.get('name')

    if not name:
        return jsonify({"error": "Please provide a name to search"}), 400

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT id, name, phone, vehicle_info, subscription_status FROM drivers WHERE name ILIKE %s", (f"%{name}%",))
    rows = cur.fetchall()

    cur.close()
    conn.close()

    drivers = []
    for row in rows:
        drivers.append({
            "id": row[0],
            "name": row[1],
            "phone": row[2],
            "vehicle_info": row[3],
            "subscription_status": row[4]
        })

    return jsonify(drivers), 200

@app.route('/drivers/<int:driver_id>', methods=['PUT'])
def update_driver(driver_id):
    data = request.get_json(silent=True)

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    name = data.get('name')
    phone = data.get('phone')
    vehicle_info = data.get('vehicle_info')

    if not name or not phone or not vehicle_info:
        return jsonify({"error": "name, phone, and vehicle_info are required"}), 400

    conn = get_connection()
    cur = conn.cursor()

    cur.execute(
        "UPDATE drivers SET name = %s, phone = %s, vehicle_info = %s WHERE id = %s",
        (name, phone, vehicle_info, driver_id)
    )

    if cur.rowcount == 0:
        cur.close()
        conn.close()
        return jsonify({"error": "Driver not found"}), 404

    conn.commit()
    cur.close()
    conn.close()

    return jsonify({"message": "Driver updated successfully"}), 200

@app.route('/drivers/<int:driver_id>', methods=['DELETE'])
def delete_driver(driver_id):
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("DELETE FROM drivers WHERE id = %s", (driver_id,))

    if cur.rowcount == 0:
        cur.close()
        conn.close()
        return jsonify({"error": "Driver not found"}), 404

    conn.commit()
    cur.close()
    conn.close()

    return jsonify({"message": "Driver deleted successfully"}), 200

@app.route('/riders', methods=['POST'])
def add_rider():
    data = request.get_json(silent=True)

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    name = data.get('name')
    phone = data.get('phone')

    if not name or not phone:
        return jsonify({"error": "name and phone are required"}), 400

    conn = get_connection()
    cur = conn.cursor()

    try:
        cur.execute(
            "INSERT INTO riders (name, phone) VALUES (%s, %s)",
            (name, phone)
        )
        conn.commit()
        cur.close()
        conn.close()
        return jsonify({"message": "Rider added successfully"}), 201

    except Exception as e:
        conn.rollback()
        cur.close()
        conn.close()
        return jsonify({"error": "A rider with this phone number already exists"}), 400

