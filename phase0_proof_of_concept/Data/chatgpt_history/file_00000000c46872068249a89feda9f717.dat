# ── Styles ────────────────────────────────────────────────────────────────────
def S(name, **kw):
    base = kw.pop('base', 'Normal')
    return ParagraphStyle(name, **kw)

COVER_H   = S('ch',  fontSize=30, textColor=WH,   fontName='Helvetica-Bold',  alignment=TA_CENTER, leading=36, spaceAfter=2)
COVER_S   = S('cs',  fontSize=12, textColor=colors.HexColor('#93c5fd'), fontName='Helvetica', alignment=TA_CENTER, spaceAfter=0)
COVER_T   = S('ct',  fontSize=9,  textColor=colors.HexColor('#bfdbfe'), fontName='Helvetica', alignment=TA_CENTER)
