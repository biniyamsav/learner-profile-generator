def mat_section(title, color, items):
    elems = []
    hdr = Table([[Paragraph(title, S('msh', fontSize=10, textColor=WH, fontName='Helvetica-Bold', spaceAfter=0))]], colWidths=[17.4*cm])
    hdr.setStyle(TableStyle([
        ('BACKGROUND',(0,0),(-1,-1),color),
        ('TOPPADDING',(0,0),(-1,-1),7),('BOTTOMPADDING',(0,0),(-1,-1),7),
        ('LEFTPADDING',(0,0),(-1,-1),10),
    ]))
    elems.append(hdr)
    for label, primary, url, when, secondary in items:
        row_data = [
            [Paragraph(f"<b>{label}</b>", S('ml', fontSize=8.5, textColor=DGR, fontName='Helvetica-Bold', spaceAfter=1)),
             Paragraph(f"<b>PRIMARY:</b> {primary}", S('mp', fontSize=8, textColor=MGRY, fontName='Helvetica', leading=12, spaceAfter=1)),
             Paragraph(f"<b>When:</b> {when}", S('mw', fontSize=7.5, textColor=GR, fontName='Helvetica', leading=11, spaceAfter=0))],
            ["",
             Paragraph(url, S('mu2', fontSize=7.5, textColor=BLUE, fontName='Helvetica-Oblique', leading=11, spaceAfter=1)),
             Paragraph(f"<b>If stuck:</b> {secondary}", S('ms', fontSize=7.5, textColor=GR, fontName='Helvetica', leading=11, spaceAfter=0))]
        ]
        r = Table(row_data, colWidths=[3*cm, 8.5*cm, 5.9*cm])
        r.setStyle(TableStyle([
            ('TOPPADDING',(0,0),(-1,-1),4),('BOTTOMPADDING',(0,0),(-1,-1),4),
            ('LEFTPADDING',(0,0),(-1,-1),8),('RIGHTPADDING',(0,0),(-1,-1),6),
            ('LINEBELOW',(0,0),(-1,-1),0.3,BDR),
            ('VALIGN',(0,0),(-1,-1),'TOP'),
            ('SPAN',(0,0),(0,1)),
        ]))
        elems.append(r)
    elems.append(Spacer(1, 0.2*cm))
    return KeepTogether(elems)

