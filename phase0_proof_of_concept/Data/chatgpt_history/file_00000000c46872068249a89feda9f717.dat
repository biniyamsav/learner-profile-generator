        Paragraph(check[4:], S('ct2', fontSize=9, textColor=MGRY, fontName='Helvetica', leading=13))
    ]], colWidths=[0.9*cm, 16.5*cm])
    row.setStyle(TableStyle([
        ('TOPPADDING',(0,0),(-1,-1),5),('BOTTOMPADDING',(0,0),(-1,-1),5),
        ('LEFTPADDING',(0,0),(-1,-1),8),('LINEBELOW',(0,0),(-1,-1),0.4,BDR),
        ('VALIGN',(0,0),(-1,-1),'MIDDLE'),
    ]))
    story.append(row)

story.append(Spacer(1, 0.4*cm))

# Final note
final_t = Table([[Paragraph(
    "<b>One last thing.</b>  You're going to hit weeks where you feel behind. Where one project is broken "
    "and another hasn't been touched in 3 days. That's normal — it happens to everyone running multiple tracks. "
    "The rule is simple: <b>don't stop, don't restart, don't add a 6th thing.</b> "
    "Finish what's in front of you. Push it. Move to the next thing. "
    "By September, the gap between you and your classmates won't be talent. It'll be whether you showed up every day.",
    S('ft', fontSize=9.5, textColor=WH, fontName='Helvetica', leading=15))
]], colWidths=[17.4*cm])
final_t.setStyle(TableStyle([
    ('BACKGROUND',(0,0),(-1,-1),DGR),
    ('TOPPADDING',(0,0),(-1,-1),14),('BOTTOMPADDING',(0,0),(-1,-1),14),
    ('LEFTPADDING',(0,0),(-1,-1),14),('RIGHTPADDING',(0,0),(-1,-1),14),
]))
story.append(final_t)

doc.build(story)
print("Done")