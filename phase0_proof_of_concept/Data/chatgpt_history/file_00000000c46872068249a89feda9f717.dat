# Rules
story.append(banner([("⚠️  THE RULES — READ THESE EVERY MONDAY MORNING", SEC_H)], RED))
story.append(Spacer(1, 0.2*cm))
rules = [
    ("1. One concept at a time.", "Finish the current ML topic before opening a new resource. Switching mid-topic resets your understanding to zero."),
    ("2. No passive learning in project blocks.", "Block 2 and Block 3 are for building. If you're watching a video, you're in the wrong block."),
    ("3. Stuck for more than 30 minutes?", "Google it for 15 more minutes. If still stuck, ask for help. Don't sit frozen for 2 hours."),
    ("4. Code every single day.", "Even Saturday. Even if it's 20 lines. Consistency beats intensity."),
    ("5. Commit before you sleep.", "If you wrote code today and didn't push it, that day didn't count."),
    ("6. Tab discipline.", "Maximum 3 browser tabs during study sessions. Close everything else. You saw what happens when you have 5 resources open."),
    ("7. Understand before moving on.", "If you can't explain a concept in one sentence without notes, you don't know it yet. Don't fake it."),
]
for title, desc in rules:
