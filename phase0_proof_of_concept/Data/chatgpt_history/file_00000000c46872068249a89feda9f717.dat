# ══════════════════════════════════════════════════════════════════════════════
# WEEK-BY-WEEK PLAN
# ══════════════════════════════════════════════════════════════════════════════
def week_block(num, title, color, status, days, deliverable, materials_this_week):
    elems = []
    # Header
    header_data = [[
        Paragraph(f"WEEK {num}", S('wn', fontSize=11, textColor=WH, fontName='Helvetica-Bold', alignment=TA_CENTER)),
        Paragraph(f"{title}  <font size=8 color='#ffffff'>— {status}</font>", WEEK_H),
    ]]
    ht = Table(header_data, colWidths=[2*cm, 15.4*cm])
    ht.setStyle(TableStyle([
        ('BACKGROUND',(0,0),(-1,-1),color),
        ('TOPPADDING',(0,0),(-1,-1),9),('BOTTOMPADDING',(0,0),(-1,-1),9),
        ('LEFTPADDING',(0,0),(-1,-1),8),('RIGHTPADDING',(0,0),(-1,-1),8),
        ('VALIGN',(0,0),(-1,-1),'MIDDLE'),
    ]))
    elems.append(ht)

    # Days table
    hdr = [Paragraph(h, DAY_LBL) for h in ["DAY","MORNING (Block 1)","AFTERNOON (Block 2)","EVENING (Block 3)"]]
    rows = [hdr]
    for day, morn, aft, eve in days:
        rows.append([
            Paragraph(day, S('dn', fontSize=8, textColor=DGR, fontName='Helvetica-Bold', alignment=TA_CENTER)),
            Paragraph(morn, CELL), Paragraph(aft, CELL), Paragraph(eve, CELL)
        ])
    dt = Table(rows, colWidths=[1.6*cm, 5.3*cm, 5.2*cm, 5.3*cm], repeatRows=1)
    dt.setStyle(TableStyle([
        ('BACKGROUND',(0,0),(-1,0),DGR),
        ('ROWBACKGROUNDS',(0,1),(-1,-1),[WH,LGR,WH,LGR,WH]),
        ('GRID',(0,0),(-1,-1),0.4,BDR),
        ('TOPPADDING',(0,0),(-1,-1),5),('BOTTOMPADDING',(0,0),(-1,-1),5),
        ('LEFTPADDING',(0,0),(-1,-1),5),('RIGHTPADDING',(0,0),(-1,-1),5),
        ('ALIGN',(0,0),(0,-1),'CENTER'),('VALIGN',(0,0),(-1,-1),'MIDDLE'),
    ]))
    elems.append(dt)

    # Deliverable + materials row
    deliv_t = Table([[
        Paragraph(f"<b>✅ Weekly Deliverable:</b> {deliverable}",
            S('dv', fontSize=8.5, textColor=MGRY, fontName='Helvetica', leading=13)),
    ]], colWidths=[17.4*cm])
    deliv_t.setStyle(TableStyle([
        ('BACKGROUND',(0,0),(-1,-1),LGLD),
        ('BOX',(0,0),(-1,-1),0.8,GOLD),
        ('TOPPADDING',(0,0),(-1,-1),6),('BOTTOMPADDING',(0,0),(-1,-1),6),
        ('LEFTPADDING',(0,0),(-1,-1),8),
    ]))
    elems.append(deliv_t)

    mat_t = Table([[
        Paragraph(f"<b>📚 Materials this week:</b> {materials_this_week}",
            S('mt', fontSize=8, textColor=MGRY, fontName='Helvetica-Oblique', leading=12)),
    ]], colWidths=[17.4*cm])
    mat_t.setStyle(TableStyle([
        ('BACKGROUND',(0,0),(-1,-1),LGR),
        ('TOPPADDING',(0,0),(-1,-1),5),('BOTTOMPADDING',(0,0),(-1,-1),5),
        ('LEFTPADDING',(0,0),(-1,-1),8),
        ('LINEBELOW',(0,0),(-1,-1),1,BDR),
    ]))
    elems.append(mat_t)
    elems.append(Spacer(1, 0.25*cm))
    return KeepTogether(elems)

story.append(banner([("🗓️  WEEK-BY-WEEK BATTLE PLAN — ALL 8 WEEKS", SEC_H)], DGR))
story.append(Spacer(1, 0.3*cm))

