        ("MON", "Google ML Crash Course: Framing, Descending into ML, Reducing Loss — read, do all exercises",
         "Inventory: Install PostgreSQL, create database, design and create all tables with correct foreign keys",
         "Ride App: Set up Flask project structure, virtual env, connect to PostgreSQL, confirm DB connection works"),
        ("TUE", "Google ML Crash Course: First Steps with TF, Generalization, Training and Test Sets modules",
         "Ride App: Build register and login endpoints for Riders and Drivers — hash passwords, return session tokens",
         "Ride App: Test auth flow end to end — register, login, logout working cleanly"),
        ("WED", "Google ML Crash Course: Validation Set, Feature Engineering, Representation modules",
         "Inventory: Write Faker script generating 10,000+ rows across all tables — run it, verify data makes sense",
         "Inventory: Write 5 SQL queries using window functions and CTEs — top products, running totals, rank by sales"),
        ("THU", "Google ML Crash Course: Feature Crosses, Regularization L1/L2 modules — take notes on each",
         "Power BI: Install Power BI Desktop, watch 3 Guy in a Cube intro videos, connect to your CSV data",
         "Ride App: Build Driver and Rider profile endpoints — GET and UPDATE profile"),
        ("FRI", "Implement from scratch in Python: train/test split, feature scaling (standardization). Compare output to sklearn.",
         "Inventory: Write pandas pipeline — load data, compute inventory turnover, flag low-stock items",
         "Ride App: Build trip request endpoint — rider requests trip, system assigns available driver"),
