CELL_B    = S('clb', fontSize=8,  textColor=DGR,  fontName='Helvetica-Bold',  spaceAfter=0,  leading=11)
MAT_H     = S('mh',  fontSize=9,  textColor=DGR,  fontName='Helvetica-Bold',  spaceAfter=1,  leading=12)
MAT_B     = S('mb',  fontSize=8,  textColor=MGRY, fontName='Helvetica',       spaceAfter=1,  leading=11)
MAT_URL   = S('mu',  fontSize=8,  textColor=BLUE, fontName='Helvetica-Oblique',spaceAfter=3, leading=11)
