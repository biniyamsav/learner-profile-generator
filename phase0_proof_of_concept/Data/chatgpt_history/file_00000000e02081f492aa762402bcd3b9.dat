import pandas as pd
from flask import Flask, jsonify, request
from flask_cors import CORS
from db import get_connection, release_connection
from flask_jwt_extended import JWTManager, create_access_token, jwt_required, get_jwt_identity, get_jwt
import bcrypt
import os
from dotenv import load_dotenv
import re

EMAIL_REGEX = re.compile(r"^[^@\s]+@[^@\s]+\.[^@\s]+$")
PHONE_REGEX = re.compile(r"^\+?\d{9,15}$")

def is_valid_email(email):
    return bool(email) and bool(EMAIL_REGEX.match(email))

def is_valid_phone(phone):
    return bool(phone) and bool(PHONE_REGEX.match(phone))

def is_valid_password(password):
    return bool(password) and len(password) >= 6

load_dotenv()

app = Flask(__name__)
CORS(app)
app.config["JWT_SECRET_KEY"] = os.getenv("JWT_SECRET_KEY")
jwt = JWTManager(app)
@app.errorhandler(Exception)
def handle_unexpected_error(e):
    return jsonify({"error": "Something went wrong, please try again"}), 500

@app.route('/drivers', methods=['POST'])
@jwt_required()
def add_driver():
    data = request.get_json(silent=True)

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    name = data.get('name')
    phone = data.get('phone')
    vehicle_info = data.get('vehicle_info')

    if not name or not phone or not vehicle_info:
        return jsonify({"error": "name, phone, and vehicle_info are required"}), 400

    if not is_valid_phone(phone):
        return jsonify({"error": "Phone must be 9-15 digits, optional + prefix"}), 400

    conn = get_connection()
    cur = conn.cursor()

    cur.execute(
        "INSERT INTO drivers (name, phone, vehicle_info, subscription_status) VALUES (%s, %s, %s, %s)",
        (name, phone, vehicle_info, 'active')
    )

    conn.commit()
    cur.close()
    release_connection(conn)

    return jsonify({"message": "Driver added successfully"}), 201


@app.route('/drivers', methods=['GET'])
@jwt_required()
def get_drivers():
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT id, name, phone, vehicle_info, subscription_status FROM drivers")
    rows = cur.fetchall()

    cur.close()
    release_connection(conn)

    drivers = []
    for row in rows:
        drivers.append({
            "id": row[0],
            "name": row[1],
            "phone": row[2],
            "vehicle_info": row[3],
            "subscription_status": row[4]
        })

    return jsonify(drivers), 200

@app.route('/drivers/<int:driver_id>', methods=['GET'])
@jwt_required()
def get_driver_by_id(driver_id):
    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT id, name, phone, vehicle_info, subscription_status FROM drivers WHERE id = %s", (driver_id,))
    row = cur.fetchone()

    cur.close()
    release_connection(conn)

    if row is None:
        return jsonify({"error": "Driver not found"}), 404

    driver = {
        "id": row[0],
        "name": row[1],
        "phone": row[2],
        "vehicle_info": row[3],
        "subscription_status": row[4]
    }

    return jsonify(driver), 200

@app.route('/drivers/search', methods=['GET'])
@jwt_required()
def search_driver_by_name():
    name = request.args.get('name')

    if not name:
        return jsonify({"error": "Please provide a name to search"}), 400

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT id, name, phone, vehicle_info, subscription_status FROM drivers WHERE name ILIKE %s", (f"%{name}%",))
    rows = cur.fetchall()

    cur.close()
    release_connection(conn)

    drivers = []
    for row in rows:
        drivers.append({
            "id": row[0],
            "name": row[1],
            "phone": row[2],
            "vehicle_info": row[3],
            "subscription_status": row[4]
        })

    return jsonify(drivers), 200

@app.route('/drivers/<int:driver_id>', methods=['PUT'])
@jwt_required()
def update_driver(driver_id):
    data = request.get_json(silent=True)

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    name = data.get('name')
    phone = data.get('phone')
    vehicle_info = data.get('vehicle_info')

    if not name or not phone or not vehicle_info:
        return jsonify({"error": "name, phone, and vehicle_info are required"}), 400

    if not is_valid_phone(phone):
        return jsonify({"error": "Phone must be 9-15 digits, optional + prefix"}), 400

    conn = get_connection()
    cur = conn.cursor()

    cur.execute(
        "UPDATE drivers SET name = %s, phone = %s, vehicle_info = %s WHERE id = %s",
        (name, phone, vehicle_info, driver_id)
    )

    if cur.rowcount == 0:
        cur.close()
        release_connection(conn)
        return jsonify({"error": "Driver not found"}), 404

    conn.commit()
    cur.close()
    release_connection(conn)

    return jsonify({"message": "Driver updated successfully"}), 200

