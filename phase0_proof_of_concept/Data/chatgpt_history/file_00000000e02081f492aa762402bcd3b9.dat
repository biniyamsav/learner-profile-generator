    rows = cur.fetchall()

    cur.close()
    release_connection(conn)

    trips = []
    for row in rows:
        trips.append({
            "id": row[0],
            "rider_id": row[1],
            "driver_id": row[2],
            "pickup_location": row[3],
            "dropoff_location": row[4],
            "status": row[5],
            "requested_at": row[6].isoformat() if row[6] else None
        })

    return jsonify(trips), 200


@app.route('/trips/<int:trip_id>', methods=['GET'])
@jwt_required()
def get_trip_by_id(trip_id):
    current_id = get_jwt_identity()
    claims = get_jwt()
    role = claims.get("role")

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("""
        SELECT
            t.id, t.rider_id, t.driver_id, t.pickup_location, t.dropoff_location, t.status, t.requested_at,
            r.name AS rider_name, r.phone AS rider_phone,
            d.name AS driver_name, d.phone AS driver_phone, d.vehicle_info
        FROM trips t
        LEFT JOIN riders r ON t.rider_id = r.id
        LEFT JOIN drivers d ON t.driver_id = d.id
        WHERE t.id = %s
    """, (trip_id,))
    row = cur.fetchone()

    cur.close()
    release_connection(conn)

    if row is None:
        return jsonify({"error": "Trip not found"}), 404

    trip_rider_id = row[1]
    trip_driver_id = row[2]

    is_owner = (
        (role == "rider" and str(trip_rider_id) == current_id) or
        (role == "driver" and trip_driver_id is not None and str(trip_driver_id) == current_id)
    )

    if not is_owner:
        return jsonify({"error": "You do not have permission to view this trip"}), 403

    trip = {
        "id": row[0],
        "rider_id": row[1],
        "driver_id": row[2],
        "pickup_location": row[3],
        "dropoff_location": row[4],
        "status": row[5],
        "requested_at": row[6].isoformat() if row[6] else None,
        "rider_name": row[7],
        "rider_phone": row[8],
        "driver_name": row[9],
        "driver_phone": row[10],
        "vehicle_info": row[11]
    }

    return jsonify(trip), 200

@app.route('/trips/<int:trip_id>/assign-driver', methods=['PUT'])
@jwt_required()
def assign_driver(trip_id):
    claims = get_jwt()
    if claims.get("role") != "driver":
        return jsonify({"error": "Only drivers can accept trips"}), 403

    data = request.get_json(silent=True)

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    driver_id = data.get("driver_id")

    if not driver_id:
        return jsonify({"error": "driver_id is required"}), 400

    conn = get_connection()
    cur = conn.cursor()

    try:
        cur.execute(
            "SELECT status FROM trips WHERE id = %s",
            (trip_id,)
        )

        trip = cur.fetchone()

        if trip is None:
            cur.close()
            release_connection(conn)
            return jsonify({"error": "Trip not found"}), 404

        if trip[0] != "requested":
            cur.close()
            release_connection(conn)
            return jsonify({
                "error": "Only requested trips can be assigned a driver"
            }), 409

        cur.execute(
            "SELECT status FROM drivers WHERE id = %s",
            (driver_id,)
        )

        driver = cur.fetchone()

        if driver is None:
            cur.close()
            release_connection(conn)
            return jsonify({"error": "Driver not found"}), 404

        if driver[0] != "available":
            cur.close()
            release_connection(conn)
            return jsonify({"error": "Driver is currently busy"}), 409

        cur.execute(
            """
            UPDATE trips
            SET driver_id = %s,
                status = 'accepted'
            WHERE id = %s
            """,
            (driver_id, trip_id)
        )

        cur.execute(
            """
            UPDATE drivers
            SET status = 'busy'
            WHERE id = %s
            """,
            (driver_id,)
        )

        conn.commit()

        cur.close()
        release_connection(conn)

        return jsonify({"message": "Driver assigned successfully"}), 200

    except Exception as e:
        conn.rollback()
        cur.close()
        release_connection(conn)
        return jsonify({"error": str(e)}), 500

@app.route('/trips/<int:trip_id>/status', methods=['PUT'])
@jwt_required()
def update_trip_status(trip_id):
    data = request.get_json(silent=True)
    new_status = data.get('status') if data else None

    allowed_statuses = ['requested', 'accepted', 'completed', 'cancelled']

    if not new_status or new_status not in allowed_statuses:
        return jsonify({"error": f"status must be one of {allowed_statuses}"}), 400

    current_id = get_jwt_identity()
    claims = get_jwt()
    role = claims.get("role")

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT rider_id, driver_id FROM trips WHERE id = %s", (trip_id,))
    trip = cur.fetchone()

    if trip is None:
        cur.close()
        release_connection(conn)
        return jsonify({"error": "Trip not found"}), 404

    trip_rider_id, trip_driver_id = trip

    is_owner = (
        (role == "rider" and str(trip_rider_id) == current_id) or
        (role == "driver" and trip_driver_id is not None and str(trip_driver_id) == current_id)
    )

    if not is_owner:
        cur.close()
        release_connection(conn)
        return jsonify({"error": "You do not have permission to update this trip"}), 403

    cur.execute("UPDATE trips SET status = %s WHERE id = %s", (new_status, trip_id))
    conn.commit()
    cur.close()
    release_connection(conn)

    return jsonify({"message": "Trip status updated successfully"}), 200

@app.route('/drivers/register', methods=['POST'])
def register_driver():
    data = request.get_json(silent=True)

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    name = data.get('name')
    phone = data.get('phone')
    vehicle_info = data.get('vehicle_info')
    email = data.get('email')
    password = data.get('password')

    if not name or not phone or not vehicle_info or not email or not password:
        return jsonify({"error": "name, phone, vehicle_info, email and password are required"}), 400

    if not is_valid_email(email):
        return jsonify({"error": "Invalid email format"}), 400

    if not is_valid_phone(phone):
        return jsonify({"error": "Phone must be 9-15 digits, optional + prefix"}), 400

    if not is_valid_password(password):
        return jsonify({"error": "Password must be at least 6 characters"}), 400

    hashed_password = bcrypt.hashpw(password.encode('utf-8'), bcrypt.gensalt())

    conn = get_connection()
    cur = conn.cursor()

    try:
        cur.execute(
            "INSERT INTO drivers (name, phone, vehicle_info, subscription_status, email, password) VALUES (%s, %s, %s, %s, %s, %s)",
            (name, phone, vehicle_info, 'active', email, hashed_password.decode('utf-8'))
        )
        conn.commit()
        cur.close()
        release_connection(conn)
        return jsonify({"message": "Driver registered successfully"}), 201

    except Exception as e:
        conn.rollback()
        cur.close()
        release_connection(conn)
        return jsonify({"error": "Email or phone already exists"}), 400

@app.route('/drivers/login', methods=['POST'])
def login_driver():
    data = request.get_json(silent=True)

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    email = data.get('email')
    password = data.get('password')

    if not email or not password:
        return jsonify({"error": "email and password are required"}), 400

    if not is_valid_email(email):
        return jsonify({"error": "Invalid email format"}), 400

    conn = get_connection()
    cur = conn.cursor()

    cur.execute("SELECT id, password FROM drivers WHERE email = %s", (email,))
    row = cur.fetchone()

    cur.close()
    release_connection(conn)

    if row is None:
        return jsonify({"error": "Invalid email or password"}), 401

    driver_id = row[0]
    stored_hash = row[1]

    if not bcrypt.checkpw(password.encode('utf-8'), stored_hash.encode('utf-8')):
        return jsonify({"error": "Invalid email or password"}), 401

    access_token = create_access_token(
        identity=str(driver_id),
        additional_claims={"role": "driver"}
    )

    return jsonify({
        "message": "Login successful",
        "access_token": access_token
    }), 200

