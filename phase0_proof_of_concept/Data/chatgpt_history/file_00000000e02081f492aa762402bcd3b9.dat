@app.route('/trips', methods=['POST'])
@jwt_required()
def create_trip():
    claims = get_jwt()
    if claims.get("role") != "rider":
        return jsonify({"error": "Only riders can request trips"}), 403

    data = request.get_json(silent=True)

    if data is None:
        return jsonify({"error": "Request body must be JSON"}), 400

    rider_id = data.get('rider_id')
    pickup_location = data.get('pickup_location')
    dropoff_location = data.get('dropoff_location')

    if not rider_id or not pickup_location or not dropoff_location:
        return jsonify({"error": "rider_id, pickup_location, and dropoff_location are required"}), 400

    if len(pickup_location.strip()) < 3 or len(dropoff_location.strip()) < 3:
        return jsonify({"error": "pickup_location and dropoff_location must be at least 3 characters"}), 400

    conn = get_connection()
    cur = conn.cursor()

    try:
        cur.execute(
            "INSERT INTO trips (rider_id, pickup_location, dropoff_location, status) VALUES (%s, %s, %s, %s)",
            (rider_id, pickup_location, dropoff_location, 'requested')
        )
        conn.commit()
        cur.close()
        release_connection(conn)
        return jsonify({"message": "Trip created successfully"}), 201

    except Exception as e:
        conn.rollback()
        cur.close()
        release_connection(conn)
        return jsonify({"error": "Could not create trip, check that rider_id exists"}), 400


@app.route('/trips', methods=['GET'])
@jwt_required()
def get_trips():
    conn = get_connection()
