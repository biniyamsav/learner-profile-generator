    return data


def supplier_most_delayed_deliveries():
    con = get_connection()
    curr = con.cursor()
    curr.execute("""
        SELECT s.name, COUNT(CASE WHEN re.status = 'delayed' THEN 1 END) AS delays
        FROM restock_events re
        INNER JOIN suppliers s ON re.supplier_id = s.id
        GROUP BY s.name
        ORDER BY delays DESC;
    """)
    data = curr.fetchall()
