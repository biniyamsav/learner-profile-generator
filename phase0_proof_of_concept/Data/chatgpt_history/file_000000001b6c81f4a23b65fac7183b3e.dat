    con = get_connection()
    curr = con.cursor()
    curr.execute("""
        SELECT s.name,
               AVG(actual_date - expected_date) AS avg_delay_days
        FROM restock_events re
        INNER JOIN suppliers s ON s.id = re.supplier_id
        WHERE actual_date IS NOT NULL
        GROUP BY s.name
        ORDER BY avg_delay_days DESC;
    """)
    data = curr.fetchall()
